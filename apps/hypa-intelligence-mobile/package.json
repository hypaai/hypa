{
  "name": "@hypa/intelligence",
  "main": "./index",
  "version": "1.0.0",
  "scripts": {
    "dev": "expo start -c",
    "generate:keyboard-languages": "node --import tsx scripts/generate-keyboard-language-catalog.ts",
    "generate:inference-contract": "node --import tsx scripts/generate-inference-contract.ts",
    "generate:ios-codegen": "node ../../node_modules/react-native/scripts/generate-codegen-artifacts.js --path . --outputPath ios --targetPlatform ios",
    "android": "npm run generate:inference-contract && npm run generate:keyboard-languages && expo run:android",
    "android:open": "npm run generate:inference-contract && npm run generate:keyboard-languages && expo start -c --android",
    "ios": "npm run generate:inference-contract && npm run generate:keyboard-languages && npm run generate:ios-codegen && expo run:ios",
    "ios:open": "npm run generate:inference-contract && npm run generate:keyboard-languages && npm run generate:ios-codegen && expo start -c --ios",
    "web": "npm run generate:inference-contract && npm run generate:keyboard-languages && expo start -c --web",
    "clean": "rm -rf .expo node_modules",
    "build:plugin": "tsc -p plugins/hypa-keyboard-android-ime",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@hypa/config": "workspace:*",
    "@hypa/translate-core": "workspace:*",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.0.0",
    "@rn-primitives/avatar": "^1.4.0",
    "@rn-primitives/label": "^1.4.0",
    "@rn-primitives/portal": "~1.4.0",
    "@rn-primitives/slot": "^1.4.0",
    "@tanstack/react-query": "^5.100.1",
    "axios": "^1.15.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~55.0.17",
    "expo-apple-authentication": "~8.0.8",
    "expo-application": "~55.0.16",
    "expo-audio": "~55.0.6",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~55.0.15",
    "expo-dev-client": "~55.0.28",
    "expo-file-system": "~55.0.22",
    "expo-glass-effect": "~55.0.11",
    "expo-haptics": "~55.0.9",
    "expo-linking": "~55.0.14",
    "expo-router": "~55.0.13",
    "expo-sharing": "~55.0.21",
    "expo-splash-screen": "~55.0.19",
    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.16",
    "expo-updates": "~55.0.21",
    "expo-video": "~55.0.15",
    "expo-web-browser": "~15.0.8",
    "hypa-keyboard-input-method-picker": "link:./n-modules/hypa-keyboard-input-method-picker",
    "hypa-keyboard-storage": "link:./n-modules/hypa-keyboard-storage",
    "lottie-react-native": "~7.3.4",
    "lucide-react-native": "^0.545.0",
    "posthog-react-native": "^4.80.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "uniwind": "^1.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.2.10",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "@types/node": "^24.10.0"
  },
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "1.32.0"
  },
  "private": true
}
